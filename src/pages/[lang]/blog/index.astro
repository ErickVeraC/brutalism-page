---
import { getCollection } from 'astro:content';
import MainLayout from '../../../layouts/MainLayout.astro';
import { languages, isLanguage, localeByLanguage, ui } from '../../../i18n';

export function getStaticPaths() {
	return languages.map(lang => ({ params: { lang } }));
}

const langParam = Astro.params.lang;

if (!isLanguage(langParam)) {
	throw new Error(`Unsupported language: ${langParam}`);
}

const lang = langParam;
const text = ui[lang].blog;
const posts = (await getCollection('blog', ({ data }) => data.lang === lang)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const languagePaths = Object.fromEntries(languages.map(code => [code, `/${code}/blog/`]));
---

<MainLayout title={text.pageTitle} lang={lang} languagePaths={languagePaths}>
	<section class="blog-archive">
		<div class="archive-header">
			<p class="mono-label accent-text">{text.label}</p>
			<h1>{text.heading[0]}<br/>{text.heading[1]}</h1>
			<p class="description mono-label">{text.description}</p>
			{lang === 'es' && (
				<a href="/rss.xml" class="rss-link mono-label" target="_blank" rel="noopener noreferrer" aria-label={text.subscribe}>
					<span class="rss-label">{text.subscribe}</span>
					<span class="rss-arrow">→</span>
				</a>
			)}
		</div>

		<div class="posts-list">
			{posts.map((post, index) => (
				<a href={`/${lang}/blog/${post.id}/`} class="post-item">
					<div class="post-index mono-label">[{String(posts.length - index).padStart(2, '0')}]</div>
					<div class="post-meta">
						<span class="pub-date mono-label">{post.data.pubDate.toLocaleDateString(localeByLanguage[lang], { year: 'numeric', month: '2-digit', day: '2-digit' })}</span>
						<h2 class="post-title">{post.data.title}</h2>
						<div class="post-tags">
							{post.data.tags.map(tag => (
								<span class="tag mono-label">#{tag}</span>
							))}
						</div>
					</div>
					<div class="post-arrow">→</div>
				</a>
			))}
		</div>

		{posts.length === 0 && (
			<div class="empty-state">
				<p class="mono-label">{text.empty}</p>
				<p>{text.emptyHint}</p>
			</div>
		)}
	</section>
</MainLayout>

<style>
	.blog-archive {
		padding: 120px 40px 80px 40px !important;
		background: var(--bg-dark);
		min-height: 100vh;
	}

	.archive-header {
		margin-bottom: 80px;
		border-bottom: var(--border-main);
		padding-bottom: 40px;
	}

	.accent-text { color: var(--accent-red); margin-bottom: 10px; }
	.description { opacity: 0.6; margin-top: 20px; max-width: 600px; line-height: 1.4; }

	.rss-link {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		margin-top: 30px;
		padding: 10px 18px;
		border: var(--border-main);
		color: var(--text-main);
		text-decoration: none;
		font-size: 0.75rem;
		transition: all 0.3s ease;
	}

	.rss-link:hover {
		border-color: var(--accent-red);
		color: var(--accent-red);
		box-shadow: var(--shadow-brutal);
	}

	.rss-arrow {
		transition: transform 0.3s ease;
	}

	.rss-link:hover .rss-arrow {
		transform: translateX(4px);
	}

	.posts-list {
		display: flex;
		flex-direction: column;
	}

	.empty-state {
		padding: 100px 0;
		text-align: center;
	}

	.empty-state .mono-label {
		color: var(--accent-red);
		margin-bottom: 12px;
	}

	.empty-state p:last-child {
		opacity: 0.65;
	}

	.post-item {
		display: grid;
		grid-template-columns: 80px 1fr 50px;
		align-items: center;
		padding: 40px 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		text-decoration: none;
		color: var(--text-main);
		transition: all 0.3s ease;
	}

	.post-item:hover {
		background: rgba(255, 255, 255, 0.02);
		padding-left: 20px;
		padding-right: 20px;
		border-bottom-color: var(--accent-red);
	}

	.post-item:hover .post-title {
		color: var(--accent-red);
	}

	.post-index {
		color: var(--accent-red);
		font-weight: bold;
	}

	.post-title {
		font-size: clamp(1.5rem, 3vw, 3rem);
		font-weight: 900;
		text-transform: uppercase;
		line-height: 1;
		margin: 10px 0;
		transition: color 0.3s ease;
	}

	.pub-date {
		opacity: 0.5;
		font-size: 0.8rem;
	}

	.post-tags {
		display: flex;
		gap: 15px;
		margin-top: 10px;
	}

	.tag {
		font-size: 0.7rem;
		opacity: 0.4;
	}

	.post-arrow {
		font-size: 2rem;
		opacity: 0;
		transform: translateX(-20px);
		transition: all 0.3s ease;
		color: var(--accent-red);
	}

	.post-item:hover .post-arrow {
		opacity: 1;
		transform: translateX(0);
	}

	@media (max-width: 768px) {
		.post-item {
			grid-template-columns: 50px 1fr;
		}
		.post-arrow { display: none; }
		.post-title { font-size: 1.5rem; }
	}
</style>
