---
import { Image } from 'astro:assets';
import MainLayout from '../../layouts/MainLayout.astro';
import Gallery from '../../components/Gallery.astro';
import Blueprints from '../../components/Blueprints.astro';
import LatestPost from '../../components/LatestPost.astro';
import WebHistoryIntro from '../../components/WebHistoryIntro.astro';
import WhoIAm from '../../components/WhoIAm.astro';
import heroImage from '../../assets/hero-concrete.webp';
---

<MainLayout title="O Arquiteto Nômade" lang="pt">
	<WebHistoryIntro
		lang="pt"
		title="O ARQUITETO NÔMADE"
		role="ARQUITETO DE SOFTWARE. DESIGNER DE SISTEMAS DE PENSAMENTO."
		quote="Construindo estruturas resilientes em código e espaço."
	/>
	<section id="home" style="min-height: 100vh; display: flex; flex-direction: column; justify-content: flex-end; position: relative; overflow: hidden; padding-bottom: 10vh; z-index: 0;">
		<div class="hero-bg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; background: var(--bg-dark);">
			<Image 
				src={heroImage} 
				alt="Blocos de concreto brutalista"
				class="sculpture-img"
				style="width: 100%; height: 100%; object-fit: cover; opacity: 0.6; filter: grayscale(100%) contrast(120%) brightness(100%);"
			/>
		</div>

		<div class="hero-content" style="position: relative; z-index: 1;">
			<p class="mono-label" style="color: var(--accent-red); margin-bottom: 20px;">// ARQUITETO DE SOFTWARE. DESIGNER DE SISTEMAS DE PENSAMENTO.</p>
			<h1>O Arquiteto<br/>Nômade</h1>
			<p style="font-size: 2rem; font-weight: 900; text-transform: uppercase; margin-top: 20px;">"Construindo estruturas resilientes em código e espaço."</p>
		</div>
	</section>

	<!-- MANIFESTO GALLERY (IDENTITY SECTION) -->
	<Gallery lang="pt" />

	<WhoIAm lang="pt" />

	<!-- BLUEPRINTS SECTION (DYNAMIC ARCHITECTURES) -->
	<Blueprints lang="pt" />

	<!-- LATEST POST -->
	<LatestPost lang="pt" />
</MainLayout>
