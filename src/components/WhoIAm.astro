---
import { Image } from 'astro:assets';
import type { Language } from '../i18n';
import erickWeb from '../assets/erick-web.webp';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const content = {
  es: {
    label: '// EL ARQUITECTO',
    title: 'QUIÉN SOY',
    alt: 'Retrato de Erick Vera',
    bio: [
      'Soy Erick Vera, arquitecto de software y tech leader en México. Llevo más de una década construyendo productos digitales, desde interfaces y plataformas web hasta sistemas distribuidos y arquitecturas de comunicación.',
      'Antes de pensar en sistemas pensé en imágenes, composición y diseño. Mi formación comenzó alrededor del arte y la comunicación visual y terminó llevándome al software. Con el tiempo descubrí que diseñar una interfaz, una arquitectura o una organización técnica comparte la misma pregunta: cómo hacer comprensible la complejidad.',
      'Hoy trabajo principalmente sobre arquitectura web, sistemas distribuidos y productos donde frontend, backend, infraestructura y negocio no pueden pensarse por separado.',
    ],
    buildTitle: 'LO QUE CONSTRUYO',
    buildItems: ['Arquitectura de software', 'Sistemas distribuidos', 'Arquitectura web', 'Liderazgo técnico', 'Ingeniería asistida por IA'],
    outsideTitle: 'FUERA DEL SOFTWARE',
    outsideText: 'Cuando no estoy diseñando software, normalmente estoy leyendo sobre historia, recorriendo arquitectura, pensando en arte o intentando aprender otro idioma.',
    outsideTags: ['Historia', 'Arquitectura', 'Arte', 'Idiomas'],
  },
  en: {
    label: '// THE ARCHITECT',
    title: 'WHO I AM',
    alt: 'Portrait of Erick Vera',
    bio: [
      'I’m Erick Vera, a software architect and tech lead based in Mexico. I’ve spent more than a decade building digital products, from interfaces and web platforms to distributed systems and communication architectures.',
      'Before I thought in systems, I thought in images, composition, and design. My path started around art and visual communication and eventually led me into software. Over time, I realized that designing an interface, an architecture, or a technical organization shares the same question: how to make complexity understandable.',
      'Today I work mainly on web architecture, distributed systems, and products where frontend, backend, infrastructure, and business cannot be designed in isolation.',
    ],
    buildTitle: 'WHAT I BUILD',
    buildItems: ['Software architecture', 'Distributed systems', 'Web architecture', 'Technical leadership', 'AI-assisted engineering'],
    outsideTitle: 'OUTSIDE SOFTWARE',
    outsideText: 'When I’m not designing software, I’m usually reading about history, exploring architecture, thinking about art, or trying to learn another language.',
    outsideTags: ['History', 'Architecture', 'Art', 'Languages'],
  },
  pt: {
    label: '// O ARQUITETO',
    title: 'QUEM SOU',
    alt: 'Retrato de Erick Vera',
    bio: [
      'Sou Erick Vera, arquiteto de software e tech lead no México. Tenho mais de uma década construindo produtos digitais, desde interfaces e plataformas web até sistemas distribuídos e arquiteturas de comunicação.',
      'Antes de pensar em sistemas, pensei em imagens, composição e design. Meu caminho começou em torno da arte e da comunicação visual e acabou me levando ao software. Com o tempo, descobri que desenhar uma interface, uma arquitetura ou uma organização técnica compartilha a mesma pergunta: como tornar a complexidade compreensível.',
      'Hoje trabalho principalmente com arquitetura web, sistemas distribuídos e produtos em que frontend, backend, infraestrutura e negócio não podem ser pensados separadamente.',
    ],
    buildTitle: 'O QUE CONSTRUO',
    buildItems: ['Arquitetura de software', 'Sistemas distribuídos', 'Arquitetura web', 'Liderança técnica', 'Engenharia assistida por IA'],
    outsideTitle: 'FORA DO SOFTWARE',
    outsideText: 'Quando não estou desenhando software, normalmente estou lendo sobre história, explorando arquitetura, pensando em arte ou tentando aprender outro idioma.',
    outsideTags: ['História', 'Arquitetura', 'Arte', 'Idiomas'],
  },
} satisfies Record<Language, {
  label: string;
  title: string;
  alt: string;
  bio: string[];
  buildTitle: string;
  buildItems: string[];
  outsideTitle: string;
  outsideText: string;
  outsideTags: string[];
}>;

const text = content[lang];
---

<section id="the-architect" class="architect-section" aria-labelledby="architect-title">
  <div class="architect-shell">
    <div class="architect-media">
      <div class="architect-photo-frame">
        <Image
          src={erickWeb}
          alt={text.alt}
          class="architect-photo"
          widths={[320, 480, 640, 800]}
          sizes="(max-width: 600px) 72vw, (max-width: 960px) 38vw, 440px"
        />
      </div>
      <span class="architect-index mono-label" aria-hidden="true">01 / IDENTITY</span>
    </div>

    <div class="architect-content">
      <p class="mono-label architect-label">{text.label}</p>
      <h2 id="architect-title">{text.title}</h2>

      <div class="architect-copy">
        {text.bio.map(paragraph => <p>{paragraph}</p>)}
      </div>

      <div class="architect-details">
        <div class="architect-subsection">
          <h3 class="mono-label">{text.buildTitle}</h3>
          <ul class="build-list">
            {text.buildItems.map(item => <li>{item}</li>)}
          </ul>
        </div>

        <div class="architect-subsection">
          <h3 class="mono-label">{text.outsideTitle}</h3>
          <p>{text.outsideText}</p>
          <ul class="tag-list" aria-label={text.outsideTitle}>
            {text.outsideTags.map(tag => <li>{tag}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .architect-section {
    padding-block: clamp(80px, 10vw, 150px);
    background: var(--bg-dark);
  }

  .architect-shell {
    width: min(1380px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(280px, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(48px, 8vw, 140px);
    align-items: start;
  }

  .architect-media {
    position: sticky;
    top: 120px;
  }

  .architect-photo-frame {
    width: min(100%, 480px);
    aspect-ratio: 1;
    border: 3px solid var(--text-main);
    border-radius: 50% !important;
    overflow: hidden;
    background: var(--text-main);
  }

  .architect-photo {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border-radius: 50% !important;
    filter: grayscale(100%) contrast(118%);
  }

  .architect-index {
    display: block;
    width: fit-content;
    margin: 18px 0 0 auto;
    padding-top: 8px;
    color: var(--accent-red);
    border-top: 2px solid var(--accent-red);
  }

  .architect-label {
    margin-bottom: 20px;
    color: var(--accent-red);
  }

  .architect-content h2 {
    margin-bottom: clamp(36px, 5vw, 64px);
    font-size: clamp(3rem, 7vw, 7.5rem);
  }

  .architect-copy {
    max-width: 820px;
    display: grid;
    gap: 1.25em;
    font-size: clamp(1.1rem, 1.45vw, 1.45rem);
    line-height: 1.55;
  }

  .architect-copy p:first-child {
    font-weight: 900;
  }

  .architect-details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: clamp(48px, 7vw, 80px);
    border-top: var(--border-main);
  }

  .architect-subsection {
    padding: 28px 0 0;
  }

  .architect-subsection + .architect-subsection {
    padding-left: 32px;
    border-left: var(--border-main);
  }

  .architect-subsection h3 {
    margin-bottom: 22px;
    color: var(--accent-red);
  }

  .build-list,
  .tag-list {
    list-style: none;
  }

  .build-list li {
    padding: 8px 0;
    border-bottom: 1px solid var(--text-main);
    font-weight: 900;
    text-transform: uppercase;
  }

  .architect-subsection > p {
    max-width: 40ch;
    line-height: 1.55;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .tag-list li {
    padding: 6px 9px;
    border: 1px solid var(--text-main);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  @media (max-width: 960px) {
    .architect-shell {
      grid-template-columns: minmax(240px, 0.7fr) minmax(0, 1.3fr);
      gap: 44px;
    }

    .architect-details {
      grid-template-columns: 1fr;
    }

    .architect-subsection + .architect-subsection {
      margin-top: 32px;
      padding-left: 0;
      padding-top: 32px;
      border-left: 0;
      border-top: var(--border-main);
    }
  }

  @media (max-width: 700px) {
    .architect-section {
      padding-block: 70px;
    }

    .architect-shell {
      grid-template-columns: 1fr;
      gap: 52px;
    }

    .architect-media {
      position: static;
    }

    .architect-photo-frame {
      width: min(72vw, 360px);
      margin-inline: auto;
    }

    .architect-index {
      margin-right: max(0px, calc((100% - min(72vw, 360px)) / 2));
    }

    .architect-content h2 {
      margin-bottom: 36px;
    }

    .architect-copy {
      max-width: 38rem;
      font-size: 1.08rem;
    }
  }
</style>
