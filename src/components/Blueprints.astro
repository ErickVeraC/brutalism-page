---
import type { Language } from '../i18n';

const { lang = 'es' } = Astro.props as { lang?: Language };

const blueprintTexts = {
  es: {
    title: "// PLANOS_TÉCNICOS",
    subtitle: "SISTEMAS DE ALTA PRECISIÓN",
    description: "Cada arquitectura responde a restricciones distintas. Selecciona un escenario para revisar sus prioridades de diseño.",
    scenarios: [
      {
        id: "landing",
        label: "01_LANDING / CONTENT FIRST",
        summary: "Enfocado en Core Web Vitals, SEO y máxima velocidad de carga estática.",
        priorities: ["Jerarquía de contenido", "Entrega estática", "Accesibilidad", "Medición", "Mantenibilidad"]
      },
      {
        id: "saas",
        label: "02_SCALABLE SAAS / WEB APP",
        summary: "Arquitectura moderna para aplicaciones interactivas con tipos seguros y despliegue rápido.",
        priorities: ["Límites de dominio", "Identidad y acceso", "Consistencia de datos", "Procesos asíncronos", "Estrategia de despliegue"]
      },
      {
        id: "highperf",
        label: "03_HIGH PERFORMANCE / EVENT-DRIVEN",
        summary: "Sistemas distribuidos para procesamiento masivo de datos y baja latencia.",
        priorities: ["Control de presión", "Idempotencia", "Aislamiento de fallos", "Throughput", "Operabilidad"]
      },
      {
        id: "ecommerce",
        label: "04_E-COMMERCE / HIGH CONVERSION",
        summary: "Plataformas de venta optimizadas para conversión, velocidad y escalabilidad global.",
        priorities: ["Ruta de conversión", "Búsqueda de catálogo", "Integridad de pagos", "Estrategia de caché", "Entrega global"]
      },
      {
        id: "admin",
        label: "05_ADMIN / INVENTORY CONTROL",
        summary: "Sistemas internos robustos con alta integridad de datos y gestión compleja de recursos.",
        priorities: ["Integridad de datos", "Roles y permisos", "Trazabilidad", "Flujos operativos", "Recuperación"]
      }
    ]
  },
  en: {
    title: "// TECHNICAL_BLUEPRINTS",
    subtitle: "HIGH PRECISION SYSTEMS",
    description: "Each architecture responds to different constraints. Select a scenario to inspect its design priorities.",
    scenarios: [
      {
        id: "landing",
        label: "01_LANDING / CONTENT FIRST",
        summary: "Focused on Core Web Vitals, SEO, and maximum static loading speed.",
        priorities: ["Content hierarchy", "Static delivery", "Accessibility", "Measurement", "Maintainability"]
      },
      {
        id: "saas",
        label: "02_SCALABLE SAAS / WEB APP",
        summary: "Modern architecture for interactive applications with type safety and fast deployment.",
        priorities: ["Domain boundaries", "Identity and access", "Data consistency", "Asynchronous work", "Deployment strategy"]
      },
      {
        id: "highperf",
        label: "03_HIGH PERFORMANCE / EVENT-DRIVEN",
        summary: "Distributed systems for massive data processing and low latency.",
        priorities: ["Backpressure", "Idempotency", "Fault isolation", "Throughput", "Operability"]
      },
      {
        id: "ecommerce",
        label: "04_E-COMMERCE / HIGH CONVERSION",
        summary: "Sales platforms optimized for conversion, speed, and global scalability.",
        priorities: ["Conversion path", "Catalog search", "Payment integrity", "Cache strategy", "Global delivery"]
      },
      {
        id: "admin",
        label: "05_ADMIN / INVENTORY CONTROL",
        summary: "Robust internal systems with high data integrity and complex resource management.",
        priorities: ["Data integrity", "Roles and permissions", "Audit trail", "Operational workflows", "Recovery"]
      }
    ]
  },
  pt: {
    title: "// PROJETOS_TÉCNICOS",
    subtitle: "SISTEMAS DE ALTA PRECISÃO",
    description: "Cada arquitetura responde a restrições diferentes. Selecione um cenário para revisar suas prioridades de design.",
    scenarios: [
      {
        id: "landing",
        label: "01_LANDING / CONTENT FIRST",
        summary: "Focado em Core Web Vitals, SEO e velocidade máxima de carregamento estático.",
        priorities: ["Hierarquia de conteúdo", "Entrega estática", "Acessibilidade", "Medição", "Manutenibilidade"]
      },
      {
        id: "saas",
        label: "02_SCALABLE SAAS / WEB APP",
        summary: "Arquitetura moderna para aplicações interativas, com tipagem segura e implantação rápida.",
        priorities: ["Limites de domínio", "Identidade e acesso", "Consistência de dados", "Processos assíncronos", "Estratégia de implantação"]
      },
      {
        id: "highperf",
        label: "03_HIGH PERFORMANCE / EVENT-DRIVEN",
        summary: "Sistemas distribuídos para processamento massivo de dados e baixa latência.",
        priorities: ["Controle de pressão", "Idempotência", "Isolamento de falhas", "Throughput", "Operabilidade"]
      },
      {
        id: "ecommerce",
        label: "04_E-COMMERCE / HIGH CONVERSION",
        summary: "Plataformas de vendas otimizadas para conversão, velocidade e escalabilidade global.",
        priorities: ["Caminho de conversão", "Busca de catálogo", "Integridade de pagamentos", "Estratégia de cache", "Entrega global"]
      },
      {
        id: "admin",
        label: "05_ADMIN / INVENTORY CONTROL",
        summary: "Sistemas internos robustos com alta integridade de dados e gestão complexa de recursos.",
        priorities: ["Integridade de dados", "Papéis e permissões", "Trilha de auditoria", "Fluxos operacionais", "Recuperação"]
      }
    ]
  }
};

const content = blueprintTexts[lang];
---

<section id="blueprints" class="blueprints-section">
  <div class="header-blueprints">
    <p class="mono-label accent-text">{content.title}</p>
    <h2>{content.subtitle}</h2>
    <p class="description mono-label">{content.description}</p>
  </div>

  <div class="command-center">
    <!-- Navegación lateral -->
    <nav class="blueprint-nav">
      {content.scenarios.map((s, index) => (
        <button
          class={`nav-item ${index === 0 ? 'active' : ''}`}
          data-id={s.id}
        >
          <span class="index">[{String(index + 1).padStart(2, '0')}]</span>
          <span class="label">{s.label}</span>
        </button>
      ))}
    </nav>

    <!-- Visualizador central -->
    <div class="display-area">
      {content.scenarios.map((s, index) => (
        <div
          id={`content-${s.id}`}
          class={`blueprint-content ${index === 0 ? 'visible' : ''}`}
        >
          <div class="blueprint-info">
            <p class="blueprint-summary">{s.summary}</p>
          </div>

          <div class="stack-grid">
            {s.priorities.map((priority, priorityIndex) => (
              <div class="tech-card">
                <div class="tech-icon-placeholder">
                  <span class="mono-label">{String(priorityIndex + 1).padStart(2, '0')}</span>
                </div>
                <span class="tech-label mono-label">{priority}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function initBlueprints() {
    const navItems = document.querySelectorAll('.nav-item');
    const contents = document.querySelectorAll('.blueprint-content');

    navItems.forEach(item => {
      item.addEventListener('click', () => {
        const targetId = (item as HTMLElement).dataset.id;

        navItems.forEach(nav => nav.classList.remove('active'));
        item.classList.add('active');

        contents.forEach(content => {
          content.classList.remove('visible');
          if (content.id === `content-${targetId}`) {
            content.classList.add('visible');
          }
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initBlueprints);
</script>
